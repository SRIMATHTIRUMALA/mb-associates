# Supabase PostgreSQL connection string (Direct or Transaction Pooler)
# Format: postgresql://postgres:[YOUR-PASSWORD]@[HOST]:[PORT]/postgres?sslmode=require
DATABASE_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?sslmode=require

# Supabase Project Configuration
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-or-publishable-key

# Application Settings
APP_ORIGIN=http://localhost:8000
SESSION_SECRET=replace-with-at-least-32-characters-random-secret-key-for-session-signing
ENVIRONMENT=development
